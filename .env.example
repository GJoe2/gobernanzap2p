# =========================================================
# CONFIGURACIÓN DE SEGURIDAD E INTEROPERABILIDAD P2P (DAMA)
# =========================================================

# MongoDB (Sovereign P2P Tokens & Polis Deliberation)
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=sovereign_secret
MONGO_INITDB_DATABASE=sovereign_db
MONGO_URI=mongodb://admin:sovereign_secret@localhost:27017/sovereign_db?authSource=admin

# PostgreSQL (Consul Collaborative Legislation Párrafos)
POSTGRES_USER=consul_admin
POSTGRES_PASSWORD=consul_secret
POSTGRES_DB=consul_ideario_db
DATABASE_URL=postgresql://consul_admin:consul_secret@localhost:5432/consul_ideario_db

# Identidad Soberana (DID) & Seguridad Criptográfica
JWT_SECRET_KEY=clave_maestra_jwt_partidaria_2026_super_segura
DID_NETWORK=stacks_testnet
SYBIL_VERIFICATION_REQUIRED=true

# Calidad y Gobernanza de Datos (DAMA-DMBOK)
DAMA_MDM_GOLDEN_RECORD_COLLECTION=afiliados_master
DAMA_NLP_SIMILARITY_THRESHOLD=0.82
DAMA_MAX_DELEGATION_HOPS=4
